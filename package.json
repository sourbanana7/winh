{
  "name": "winh",
  "version": "1.0.2",
  "description": "Winh - Ambient edge lighting, tray flyout controls, WASAPI beat sync, and fullscreen synced lyrics for Windows",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "dist": "electron-builder --win",
    "check": "node --check index.js && node --check src/smtc.js && node --check src/lyrics.js && node --check src/backend/audioMeter.js && node --check src/backend/artworkLookup.js && node --check src/backend/colorExtractor.js && node --check src/backend/monitorLayout.js && node --check src/backend/paths.js && node --check src/backend/settingsStore.js && node --check src/backend/trayIcon.js"
  },
  "keywords": [
    "winh",
    "electron",
    "windows",
    "ambient",
    "rim-light",
    "lyrics",
    "smtc",
    "wasapi"
  ],
  "author": "Affan09",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.winh.app",
    "productName": "Winh",
    "asar": true,
    "asarUnpack": [
      "smtc_watcher.ps1",
      "src/backend/WasapiAudioMeter.cs"
    ],
    "files": [
      "index.js",
      "package.json",
      "smtc_watcher.ps1",
      "src/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Winh",
      "artifactName": "Winh-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Winh-Portable-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  }
}
